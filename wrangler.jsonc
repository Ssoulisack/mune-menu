{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mune",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The React app. Anything not under /api or /img falls back to index.html (SPA routing).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mune-db",
      "database_id": "cd58d2c3-24c0-46cb-9dc0-b6072afd99ab",
      "migrations_dir": "migrations"
    }
  ],

  // Item photos. KV needs no payment card. To use R2 instead, add an "r2_buckets"
  // entry with binding "IMAGES_R2" — the worker prefers R2 when that binding exists.
  "kv_namespaces": [
    {
      "binding": "IMAGES_KV",
      "id": "c34ed962db79422fba56e54ac4c9a6ae"
    }
  ],

  "vars": {
    // Cloudflare Access settings for the backoffice (see README).
    "ACCESS_TEAM_DOMAIN": "24thurs.cloudflareaccess.com",
    "ACCESS_AUD": "abe0e58646a4bd2fe4b061299ec9cf560e753e01cbb905988d1782a875f57b67"
  },

  // Public address. Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "menu.24thurs.site", "custom_domain": true }]
}
